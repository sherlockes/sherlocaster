    channels:
      - channel: "jordillatzer"
        name: "Jordi Llatzer"
    content: vods
    limit_days: 5
    limit: 1
    audio_bitrate: "64k"

settings:
  speed: 1.5
  audio_bitrate: "64k"

storage:
  base_path: "/data"
  audio_dir: "audio"
  temp_dir: "tmp"
  state_file: "state/episodes.json"

feed:
  file_name: "feed.xml"
