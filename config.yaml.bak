  copyright: "2026 Sherlockes"
  author: "Sherlockes"

rclone:
  remote: "Sherlockes78_GD"
  path: "/sherlocaster"
  retention_days: 15

retention:
  days: 300
  max_items: 300
  purge_audio: false

feed_limit: 500
